<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      spacing="12"
      alignment="CENTER"
      prefWidth="850"
      prefHeight="650"
      style="-fx-padding: 20;">

    <Label text="Administradora de Viviendas"
           style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10">
        <Label text="Tipo:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cmbTipo" promptText="Seleccionar tipo"
                  GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Código:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="txtCodigo" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Superficie:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="txtSuperficie" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Habitaciones:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="txtHabitaciones" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Piso:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextField fx:id="txtPiso" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <CheckBox fx:id="chkGastoComun" text="Gasto común al día"
                  GridPane.rowIndex="5" GridPane.columnIndex="1"/>

        <CheckBox fx:id="chkEstacionamiento" text="Estacionamiento"
                  GridPane.rowIndex="6" GridPane.columnIndex="1"/>

        <CheckBox fx:id="chkPatio" text="Tiene patio"
                  GridPane.rowIndex="7" GridPane.columnIndex="1"/>
    </GridPane>

    <Button fx:id="btnRegistrar" text="Registrar vivienda"/>

    <TableView fx:id="tablaViviendas" prefHeight="220">
        <columns>
            <TableColumn fx:id="colTipo" text="Tipo" prefWidth="130"/>
            <TableColumn fx:id="colCodigo" text="Código" prefWidth="130"/>
            <TableColumn fx:id="colSuperficie" text="Superficie (m²)" prefWidth="140"/>
            <TableColumn fx:id="colHabitaciones" text="Habitaciones" prefWidth="130"/>
            <TableColumn fx:id="colCosto" text="Costo arriendo" prefWidth="150"/>
        </columns>
    </TableView>

    <Button fx:id="btnEliminar" text="Eliminar vivienda"/>

    <Label fx:id="lblMensaje" text="Sistema iniciado."/>

</VBox>
